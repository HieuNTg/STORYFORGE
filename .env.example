# =============================================================================
# StoryForge environment variables
# =============================================================================
# Docker users: you usually need none of these. Run `docker compose up` and set
# your API key in Settings. To pass a variable to the containers, add it under
# `environment:` of the api service in a compose.override.yaml (see
# docs/self-hosting.md). A .env file next to compose.yaml does NOT reach the
# containers.
# Running from source: copy this file to .env; the API loads it at startup
# (config/__init__.py). Variables already exported in your shell win over .env;
# blank values are ignored.
# Every variable below is optional and is read by the code in this repo.
# =============================================================================


# --- Server ------------------------------------------------------------------

# Bind address and port of the API. Loopback by default; a non-loopback host
# is refused at startup unless STORYFORGE_ACCESS_TOKEN is set (the Docker
# images are the exception: they bind inside the container and publish to
# 127.0.0.1 only).
# STORYFORGE_HOST=127.0.0.1
# STORYFORGE_PORT=7860

# "1" enables /docs, /redoc and /openapi.json (development only).
# STORYFORGE_DEBUG=

# Set by the Docker images, not for users: STORYFORGE_IN_CONTAINER=1


# --- Access and network security ---------------------------------------------

# Optional shared access token. Leave unset while StoryForge only listens on
# this machine. Required before exposing it to a network.
# STORYFORGE_ACCESS_TOKEN=

# Extra Host header names to accept, comma-separated, names only (no ports or
# wildcards). Defaults: localhost, 127.0.0.1, [::1], api, host.docker.internal.
# STORYFORGE_ALLOWED_HOSTS=storyforge.lan

# Extra browser origins (CORS and Origin checks), comma-separated, full origins.
# STORYFORGE_ALLOWED_ORIGINS=http://storyforge.lan:3001

# Trusted reverse-proxy IPs whose X-Forwarded-For header is honored.
# TRUSTED_PROXY_IPS=

# "1" lets the LLM/image base URL point at private-network addresses (LAN
# servers). Off by default as an SSRF guard; host.docker.internal is always allowed.
# STORYFORGE_ALLOW_PRIVATE_BASE_URL=

# Block prompt-injection attempts; "false" logs without blocking.
# STORYFORGE_BLOCK_INJECTION=true

# Optional: your own Fernet key for encrypting stored API keys. If unset, a key
# is generated on first start and saved to data/.secret_key (back it up with
# data/config.json). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORYFORGE_SECRET_KEY=

# Rate limits, requests per minute per client, and a switch to turn them off.
# STORYFORGE_RATE_LIMIT_DEFAULT=240
# STORYFORGE_RATE_LIMIT_EXPENSIVE=60
# STORYFORGE_FORGE_RATE_LIMIT=5
# STORYFORGE_CHARACTER_RATE_LIMIT=10
# STORYFORGE_SIMULATION_RATE_LIMIT=10
# STORYFORGE_DISABLE_RATE_LIMIT=


# --- LLM and image providers (override Settings / data/config.json) ----------

# STORYFORGE_API_KEY=
# STORYFORGE_BASE_URL=https://api.openai.com/v1
# STORYFORGE_MODEL=
# STORYFORGE_REQUEST_TIMEOUT=
# STORYFORGE_TEMPERATURE=

# Image provider: openai, hf, replicate, seedream or none.
# STORYFORGE_IMAGE_PROVIDER=none
# IMAGE_API_KEY=
# IMAGE_API_URL=
# HF_TOKEN=
# REPLICATE_API_KEY=
# SEEDREAM_API_KEY=
# SEEDREAM_API_URL=

# Fallback-chain provider keys, picked up automatically when set.
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# ZAI_API_KEY=

# Long-context model for whole-story passes.
# STORYFORGE_LONG_CONTEXT=
# LONG_CONTEXT_PROVIDER=
# LONG_CONTEXT_MODEL=
# LONG_CONTEXT_API_KEY=
# LONG_CONTEXT_BASE_URL=


# --- Pipeline feature flags (override Settings) ------------------------------

# STORYFORGE_QUALITY_GATE=
# STORYFORGE_GATE_THRESHOLD=
# STORYFORGE_SMART_REVISION=
# STORYFORGE_AGENT_DEBATE=
# STORYFORGE_AGENTIC_REPAIR=
# STORYFORGE_LENGTH_GATE=
# STORYFORGE_LENGTH_GATE_RATIO=
# STORYFORGE_CHAR_CONSISTENCY=
# STORYFORGE_RAG_ENABLED=
# STORYFORGE_RAG_DIR=
# STORYFORGE_LITE_MODE=false
# STORYFORGE_MAX_TOTAL_RETRIES=
# STORYFORGE_HANDOFF_STRICT=
# STORYFORGE_SEMANTIC_STRICT=
# STORYFORGE_PROMPTS_FILE=


# --- Storage -----------------------------------------------------------------

# All app data is local: SQLite plus files. Defaults are under data/ and output/.
# STORYFORGE_DB_PATH=data/storyforge.db
# STORYFORGE_LLM_CACHE_DB=data/llm_cache.db
# STORYFORGE_OUTPUT_ROOT=output
# STORYFORGE_FEEDBACK_DIR=data/feedback
# STORYFORGE_COST_LOG=
# STORYFORGE_TOKEN_PRICING=
# CHROMA_PERSIST_DIR=data/chromadb
# CHROMA_COLLECTION_NAME=storyforge_world


# --- Logging and debugging ---------------------------------------------------

# "text" or "json".
# LOG_FORMAT=text
# Echo SQL statements ("1" or "true").
# DB_ECHO=false
# Do not load .env at all.
# STORYFORGE_SKIP_DOTENV=

# Base URL of a running instance, for scripts/demo_video.py.
# STORYFORGE_URL=http://localhost:7860
